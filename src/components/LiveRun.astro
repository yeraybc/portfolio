---
import { readFileSync } from 'node:fs';
import type { Locale } from '../i18n/ui';
import { useT, localePath } from '../i18n/utils';
import { fmtNum, fmtPct } from '../lib/format';
import { LIVE_RUN, FEATURE_SET_KEYS, HIDDEN_OPTIONS, LR_OPTIONS, DEFAULT_RUN, type FeatureSet } from '../lib/live-run-config';
import { liveRunSvg, heightFor, yRange } from '../lib/live-run-svg';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = useT(locale);
const data = JSON.parse(readFileSync(new URL('../../public/data/live-run.json', import.meta.url), 'utf8'));
const curve: number[] = data.curve;
const ols: number = data.meta.ols_val_rmse;

const fmt = (v: number) => fmtNum(v, locale, 0);
const fmtLr = (v: number) => new Intl.NumberFormat(locale === 'es' ? 'es-ES' : 'en-GB', { maximumSignificantDigits: 2 }).format(v);
const geom = { epochs: LIVE_RUN.epochs, ols, ...yRange([...curve, ols]) };
const final = curve.at(-1)!;
const firstBeat = curve.findIndex((v) => v < ols) + 1;
const W = 640;
const svg = liveRunSvg(geom, W, curve, { epoch: t('live.epoch'), baseline: t('live.baseline'), fmt }, curve);
const config = { ...geom, curve, url: '/data/live-run.json', run: DEFAULT_RUN };
const setLabel: Record<FeatureSet, string> = {
  all: t('live.set.all'),
  no_lag: t('live.set.no_lag'),
  location: t('live.set.location'),
  house: t('live.set.house'),
};
const strings = {
  training: t('live.training'),
  beats: t('live.beats'),
  miss: t('live.miss'),
  epoch: t('live.epoch'),
  baseline: t('live.baseline'),
  firstBeat,
};
const pct = ((final - ols) / ols) * 100;
---

<section class="live panel" aria-labelledby="live-title" data-live-run data-config={JSON.stringify(config)} data-strings={JSON.stringify(strings)}>
  <header class="live-head">
    <div>
      <h2 id="live-title">{t('live.title')}</h2>
      <p class="sub">{t('live.subtitle')}</p>
    </div>
    <div class="readout" aria-hidden="true">
      <div><span class="k">{t('live.epoch')}</span><span class="v num" data-epoch>{LIVE_RUN.epochs}</span></div>
      <div><span class="k">RMSE</span><span class="v num" data-val>{fmt(final)}</span></div>
      <div><span class="k">{t('live.baseline')}</span><span class="v num base" data-base>{fmt(ols)}</span></div>
    </div>
  </header>

  <div class="chart-box">
  <svg viewBox={`0 0 ${W} ${heightFor(W)}`} width={W} height={heightFor(W)} class="chart" role="img" aria-label={`${t('live.metric')}. ${t('live.baseline')} ${fmt(ols)}. ${t('run.final')} ${fmt(final)}.`} set:html={svg} data-chart />
  </div>

  <footer class="live-foot">
    <p class="state" data-state>
      <span class="pill done" data-pill><span aria-hidden="true">✓</span> {t('live.beats')}</span>
      <span class="muted static-note">{t('live.static')}</span>
    </p>
  </footer>

  <form class="controls" data-controls>
    <fieldset>
      <legend>{t('live.controls')}</legend>
      <label>
        <span>{t('live.features')}</span>
        <select name="set">{FEATURE_SET_KEYS.map((k) => <option value={k} selected={k === DEFAULT_RUN.set}>{setLabel[k]}</option>)}</select>
      </label>
      <label>
        <span>{t('live.hidden')}</span>
        <select name="hidden">{HIDDEN_OPTIONS.map((h) => <option value={h} selected={h === DEFAULT_RUN.hidden}>{h}</option>)}</select>
      </label>
      <label>
        <span>{t('live.lr')}</span>
        <select name="lr">{LR_OPTIONS.map((lr) => <option value={lr} selected={lr === DEFAULT_RUN.lr}>{fmtLr(lr)}</option>)}</select>
      </label>
      <button class="btn btn-primary" type="submit">{t('live.train')}</button>
    </fieldset>
    <p class="hint">{t('live.hint')}</p>
  </form>

  <div class="table-wrap">
    <table class="exp">
      <caption class="visually-hidden">{t('live.runs')}</caption>
      <thead>
        <tr>
          <th scope="col">{t('live.features')}</th>
          <th scope="col" class="n hp">{t('live.col.hidden')}</th>
          <th scope="col" class="n hp">LR</th>
          <th scope="col" class="n">OLS</th>
          <th scope="col" class="n">MLP</th>
          <th scope="col" class="n">{t('live.col.delta')}</th>
        </tr>
      </thead>
      <tbody data-exp>
        <tr class="current">
          <th scope="row">{setLabel[DEFAULT_RUN.set]}</th>
          <td class="n num hp">{DEFAULT_RUN.hidden}</td>
          <td class="n num hp">{fmtLr(DEFAULT_RUN.lr)}</td>
          <td class="n num">{fmt(ols)}</td>
          <td class="n num">{fmt(final)}</td>
          <td class="n num"><span class={`delta ${pct < 0 ? 'better' : 'worse'}`}>{fmtPct(pct, locale)}</span></td>
        </tr>
      </tbody>
    </table>
  </div>

  <p class="note">
    {t('live.note')} <a href={localePath('/projects/madrid-data-house', locale)} data-internal>{t('live.open')}</a>
  </p>
  <p class="visually-hidden" aria-live="polite" data-announce></p>
</section>

<script>
  import { initLiveRun } from '../lib/live-run-client';
  document.querySelectorAll<HTMLElement>('[data-live-run]').forEach(initLiveRun);
</script>

<style>
  .live {
    padding: var(--s5);
    display: grid;
    gap: var(--s4);
  }
  .live-head {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--s4);
  }
  h2 {
    font-size: var(--fs-lg);
  }
  .sub {
    margin-top: 4px;
    color: var(--text-2);
    font-size: var(--fs-sm);
  }
  .readout {
    display: flex;
    gap: var(--s5);
  }
  .readout div {
    display: grid;
    gap: 2px;
  }
  .k {
    font-size: var(--fs-xs);
    color: var(--muted);
  }
  .v {
    font-size: var(--fs-lg);
    min-width: 4ch;
  }
  .v.base {
    color: var(--text-2);
  }
  /* Fixed height (same rule as heightFor) so the client redraw never shifts the layout. */
  .chart-box {
    container-type: inline-size;
  }
  .chart {
    display: block;
    width: 100%;
    height: 240px;
    touch-action: pan-y;
  }
  @container (max-width: 479px) {
    .chart {
      height: 200px;
    }
  }
  .chart :global(.grid) {
    stroke: var(--rule);
    stroke-width: 1;
  }
  .chart :global(.tick) {
    font: 11px var(--font-mono);
    fill: var(--muted);
  }
  .chart :global(.ols) {
    stroke: var(--base);
    stroke-width: 1.5;
  }
  .chart :global(.ols-lbl) {
    font: 11px var(--font-sans);
    fill: var(--text-2);
  }
  .chart :global(.curve) {
    fill: none;
    stroke: var(--live);
    stroke-width: 2;
    stroke-linejoin: round;
    stroke-linecap: round;
  }
  .chart :global(.head) {
    fill: var(--live);
    stroke: var(--panel);
    stroke-width: 2;
  }
  .chart :global(.cross) {
    stroke: var(--muted);
    stroke-width: 1;
  }
  .chart :global(.hover-lbl) {
    font: 11px var(--font-mono);
    fill: var(--text);
  }
  /* With JS and motion allowed, the live path replaces the static one (no flash before JS runs). */
  @media (prefers-reduced-motion: no-preference) {
    :global(html.js) .live:not([data-static]) :global(.curve-static) {
      visibility: hidden;
    }
  }
  .live-foot {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--s3);
  }
  .state {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--s3);
    font-size: var(--fs-sm);
  }
  .pill {
    display: inline-flex;
    gap: 6px;
    padding: 2px 10px;
    border-radius: 999px;
    border: 1px solid currentColor;
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
  }
  .pill.done {
    color: var(--good);
  }
  .pill.training {
    color: var(--live);
  }
  .note {
    font-size: var(--fs-xs);
    color: var(--muted);
  }
  .pill.miss {
    color: var(--bad);
  }
  .chart :global(.curve-prev) {
    stroke: var(--base);
    stroke-width: 1.25;
    opacity: 0.55;
  }
  /* The controls need JS; html.js is set before paint, so showing them never shifts the layout. */
  .controls {
    display: none;
    gap: var(--s3);
  }
  :global(html.js) .controls {
    display: grid;
  }
  fieldset {
    display: flex;
    flex-wrap: wrap;
    align-items: end;
    gap: var(--s3) var(--s4);
    margin: 0;
    padding: 0;
    border: 0;
  }
  legend {
    width: 100%;
    margin-bottom: var(--s2);
    padding: 0;
    font-size: var(--fs-sm);
    font-weight: 500;
  }
  label {
    display: grid;
    gap: 4px;
    font-size: var(--fs-xs);
    color: var(--muted);
  }
  select {
    min-height: 36px;
    padding: 0 var(--s3);
    border: 1px solid var(--rule);
    border-radius: 6px;
    background: var(--panel-2);
    color: var(--text);
    font: inherit;
    font-size: var(--fs-sm);
  }
  .hint {
    font-size: var(--fs-sm);
    color: var(--text-2);
  }
  .table-wrap {
    overflow-x: auto;
  }
  .exp {
    width: 100%;
    border-collapse: collapse;
    font-size: var(--fs-sm);
  }
  .exp th,
  .exp td {
    padding: 6px var(--s3);
    border-top: 1px solid var(--rule);
    text-align: left;
    white-space: nowrap;
  }
  .exp thead th {
    border-top: 0;
    font-size: var(--fs-xs);
    font-weight: 500;
    color: var(--muted);
  }
  .exp tbody th {
    font-weight: 400;
  }
  .exp .n {
    text-align: right;
  }
  .exp tr.current th {
    box-shadow: inset 2px 0 0 var(--live);
  }
  .exp tbody tr:not(.current) {
    color: var(--text-2);
  }
  /* On phones the hyper-parameters stay in the selects; the table keeps the comparison. */
  @media (max-width: 560px) {
    .exp .hp {
      display: none;
    }
    .exp tbody th {
      white-space: normal;
    }
  }
</style>
