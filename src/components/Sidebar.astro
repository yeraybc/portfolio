---
import type { Locale } from '../i18n/ui';
import { useT, localePath } from '../i18n/utils';
import { LENSES } from '../lib/lens';

interface Props {
  locale: Locale;
  path: string;
}
const { locale, path } = Astro.props;
const t = useT(locale);
const other = locale === 'en' ? 'es' : 'en';

const nav = [
  { href: '/', label: t('nav.overview') },
  { href: '/projects', label: t('nav.runs') },
  { href: '/compare', label: t('nav.compare') },
  { href: '/match', label: t('nav.match') },
  { href: '/deployments', label: t('nav.deployments') },
  { href: '/model-card', label: t('nav.modelCard') },
  { href: '/cv', label: t('nav.cv') },
];
const isCurrent = (href: string) => (href === '/' ? path === '/' : path === href || path.startsWith(`${href}/`));
---

<header class="sidebar">
  <div class="brand-row">
    <a class="brand" href={localePath('/', locale)}>
      <span class="name">Yeray Benito</span>
      <span class="role">{t('role')}</span>
    </a>
    <button class="menu-btn btn btn-ghost" type="button" aria-expanded="false" aria-controls="site-nav" data-menu-toggle>
      {t('nav.menu')}
    </button>
  </div>

  <div class="drawer" id="site-nav">
    <nav aria-label="Main">
      <ul>
        {
          nav.map((item) => (
            <li>
              <a href={localePath(item.href, locale)} aria-current={isCurrent(item.href) ? 'page' : undefined} data-internal>
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="lens">
      <label for="lens-select">{t('lens.label')}</label>
      <select id="lens-select" data-lens-select>
        {LENSES.map((l) => <option value={l}>{t(`lens.${l}`)}</option>)}
      </select>
    </div>

    <div class="controls">
      <button class="btn btn-ghost ctl" type="button" data-cmdk-open aria-label={t('cmdk.open')}>
        <span>{t('cmdk.open')}</span>
        <kbd data-cmdk-hint>⌘K</kbd>
      </button>
      <button class="btn btn-ghost ctl" type="button" data-theme-toggle aria-label={t('theme.toggle')}>
        <svg width="16" height="16" viewBox="0 0 16 16" aria-hidden="true">
          <circle cx="8" cy="8" r="6.25" fill="none" stroke="currentColor" stroke-width="1.5"></circle>
          <path d="M8 1.75a6.25 6.25 0 0 1 0 12.5z" fill="currentColor"></path>
        </svg>
      </button>
      <a class="btn btn-ghost ctl" href={localePath(path, other)} hreflang={other} lang={other} data-lang-link>
        {t('lang.code')}
      </a>
    </div>
  </div>
</header>

<style>
  .sidebar {
    position: sticky;
    top: 0;
    height: 100vh;
    display: flex;
    flex-direction: column;
    gap: var(--s6);
    padding: var(--s6) var(--s5);
    border-right: 1px solid var(--rule);
    background: var(--bg);
  }
  .brand {
    display: grid;
    gap: 2px;
    text-decoration: none;
  }
  .name {
    font-family: var(--font-cond);
    font-weight: 600;
    font-size: var(--fs-lg);
    letter-spacing: -0.005em;
  }
  .role {
    color: var(--text-2);
    font-size: var(--fs-sm);
  }
  .menu-btn {
    display: none;
  }
  .drawer {
    display: flex;
    flex-direction: column;
    gap: var(--s6);
    flex: 1;
  }
  nav ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 2px;
  }
  nav a {
    display: block;
    padding: 6px var(--s3);
    margin-left: calc(-1 * var(--s3));
    border-left: 2px solid transparent;
    color: var(--text-2);
    text-decoration: none;
    font-size: var(--fs-sm);
  }
  nav a:hover {
    color: var(--text);
  }
  nav a[aria-current='page'] {
    color: var(--text);
    font-weight: 500;
    border-left-color: var(--live);
  }
  .lens {
    display: grid;
    gap: var(--s2);
    font-size: var(--fs-sm);
    color: var(--text-2);
  }
  select {
    width: 100%;
    min-height: 36px;
    padding: 0 var(--s2);
    border: 1px solid var(--rule);
    border-radius: var(--radius);
    background: var(--panel);
    color: var(--text);
    font: inherit;
  }
  .controls {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s2);
    margin-top: auto;
  }
  .ctl {
    padding: 0 var(--s3);
  }
  kbd {
    font-size: var(--fs-xs);
    color: var(--muted);
  }

  @media (max-width: 960px) {
    .sidebar {
      position: sticky;
      height: auto;
      z-index: 20;
      gap: 0;
      padding: var(--s3) var(--s4);
      border-right: 0;
      border-bottom: 1px solid var(--rule);
    }
    .brand-row {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: var(--s3);
    }
    .brand {
      grid-auto-flow: column;
      align-items: baseline;
      gap: var(--s2);
    }
    .name {
      font-size: var(--fs-md);
    }
    :global(html.js) .menu-btn {
      display: inline-flex;
    }
    .drawer {
      gap: var(--s5);
      padding: var(--s4) 0 var(--s2);
    }
    :global(html.js) .drawer:not(.open) {
      display: none;
    }
    .controls {
      margin-top: 0;
    }
  }
</style>
