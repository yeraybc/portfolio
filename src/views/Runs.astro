---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import RunsTable from '../components/RunsTable.astro';
import StatusBadge from '../components/StatusBadge.astro';
import type { Locale } from '../i18n/ui';
import { useT, tr, localePath } from '../i18n/utils';
import { toolGroups } from '../data/profile';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = useT(locale);
const all = (await getCollection('runs')).filter((r) => !r.data.hidden);
const byRank = (a: (typeof all)[number], b: (typeof all)[number]) => (a.data.lens_rank.ds ?? 99) - (b.data.lens_rank.ds ?? 99);
const active = all.filter((r) => r.data.status !== 'archived').sort(byRank);
const archived = all.filter((r) => r.data.status === 'archived').sort(byRank);
const statuses = ['production', 'running', 'pilot', 'research'] as const;
const uses = (tool: string) => active.filter((r) => r.data.stack.includes(tool)).length;
const used = new Set(active.flatMap((r) => r.data.stack));
const grouped = new Set(toolGroups.flatMap((g) => g.tools));
const other = [...used].filter((tool) => !grouped.has(tool)).sort((a, b) => a.localeCompare(b));
const groups = [
  ...toolGroups.map((g) => ({ id: g.id, label: tr(g.label, locale), tools: g.tools.filter((tool) => used.has(tool)) })),
  { id: 'other', label: t('runs.filter.other'), tools: other },
]
  .filter((g) => g.tools.length > 0)
  .map((g) => ({ ...g, count: active.filter((r) => r.data.stack.some((tool) => g.tools.includes(tool))).length }));
---

<Base locale={locale} path="/projects" title={t('runs.title')} description={t('runs.lede')}>
  <header class="page-head">
    <h1>{t('runs.title')}</h1>
    <p>{t('runs.lede')}</p>
  </header>

  <form class="filters" data-filters hidden aria-label={t('runs.filter.status')}>
    <fieldset class="seg">
      <legend class="visually-hidden">{t('runs.filter.status')}</legend>
      <label><input type="radio" name="status" value="all" checked /><span>{t('runs.filter.all')}</span></label>
      {
        statuses.map((s) => (
          <label>
            <input type="radio" name="status" value={s} />
            <span>
              <StatusBadge status={s} locale={locale} />
            </span>
          </label>
        ))
      }
    </fieldset>
    <label class="tool">
      <span class="visually-hidden">{t('runs.filter.stack')}</span>
      <select name="tool">
        <option value="">{t('runs.filter.anyStack')}</option>
        {
          groups.map((g) => (
            <optgroup label={g.label}>
              <option value={`group:${g.tools.join('|')}`}>
                {t('runs.filter.groupAll').replace('{group}', g.label)} ({g.count})
              </option>
              {g.tools.map((tool) => (
                <option value={tool}>
                  {tool} ({uses(tool)})
                </option>
              ))}
            </optgroup>
          ))
        }
      </select>
    </label>
    <p class="count num" aria-live="polite" data-count></p>
  </form>

  <RunsTable runs={active} locale={locale} id="runs-table" maxStack={5} />
  <div class="empty panel" data-empty hidden>
    <p>{t('runs.empty')}</p>
    <button type="button" class="btn" data-clear>{t('runs.clear')}</button>
  </div>

  <details class="archived section">
    <summary>
      <span class="sum-title">{t('runs.archived')}</span>
      <span class="num muted">{archived.length}</span>
    </summary>
    <p class="muted">{t('runs.archivedNote')}</p>
    <ul>
      {
        archived.map((r) => (
          <li>
            <a href={localePath(`/projects/${r.id}`, locale)} data-internal>
              {tr(r.data.title, locale)}
            </a>
            <span class="muted">{tr(r.data.summary, locale)}</span>
            {r.data.headline_text && <span class="num">{tr(r.data.headline_text, locale)}</span>}
          </li>
        ))
      }
    </ul>
  </details>

  <p class="section compare">
    <a class="btn" href={localePath('/compare', locale)} data-internal>{t('cta.compare')}</a>
  </p>
</Base>

<script>
  const form = document.querySelector<HTMLFormElement>('[data-filters]');
  const rows = Array.from(document.querySelectorAll<HTMLTableRowElement>('#runs-table tbody tr'));
  const empty = document.querySelector<HTMLElement>('[data-empty]')!;
  const count = document.querySelector<HTMLElement>('[data-count]')!;
  const table = document.querySelector<HTMLElement>('#runs-table')!.parentElement!;
  if (form) {
    form.hidden = false;
    const apply = () => {
      const status = (form.elements.namedItem('status') as RadioNodeList).value;
      const tool = (form.elements.namedItem('tool') as HTMLSelectElement).value;
      const wanted = tool.startsWith('group:') ? tool.slice(6).split('|') : tool ? [tool] : [];
      let shown = 0;
      rows.forEach((r) => {
        const stack = r.dataset.stack!.split('|');
        const ok = (status === 'all' || r.dataset.status === status) && (!wanted.length || wanted.some((w) => stack.includes(w)));
        r.hidden = !ok;
        if (ok) shown++;
      });
      empty.hidden = shown > 0;
      table.hidden = shown === 0;
      count.textContent = `${shown} / ${rows.length}`;
    };
    form.addEventListener('change', apply);
    form.addEventListener('submit', (e) => e.preventDefault());
    document.querySelector('[data-clear]')?.addEventListener('click', () => {
      form.reset();
      apply();
    });
    apply();
  }
</script>

<style>
  .filters {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--s3);
    margin-bottom: var(--s4);
  }
  .filters[hidden] {
    display: none;
  }
  .seg {
    display: flex;
    flex-wrap: wrap;
    gap: 0;
    margin: 0;
    padding: 0;
    border: 1px solid var(--rule);
    border-radius: var(--radius);
    background: var(--panel);
    overflow: hidden;
  }
  .seg label {
    position: relative;
  }
  .seg input {
    position: absolute;
    opacity: 0;
    inset: 0;
    cursor: pointer;
  }
  .seg span {
    display: inline-flex;
    align-items: center;
    min-height: 34px;
    padding: 0 var(--s3);
    font-size: var(--fs-sm);
    color: var(--text-2);
    border-right: 1px solid var(--rule);
  }
  .seg label:last-child > span {
    border-right: 0;
  }
  .seg input:checked + span {
    background: var(--panel-2);
    color: var(--text);
    box-shadow: inset 0 -2px 0 var(--live);
  }
  .seg input:focus-visible + span {
    outline: 2px solid var(--focus);
    outline-offset: -2px;
  }
  select {
    min-height: 36px;
    padding: 0 var(--s2);
    border: 1px solid var(--rule);
    border-radius: var(--radius);
    background: var(--panel);
    color: var(--text);
    font: inherit;
    font-size: var(--fs-sm);
  }
  .count {
    margin-left: auto;
    font-size: var(--fs-xs);
    color: var(--muted);
  }
  .empty {
    display: grid;
    justify-items: start;
    gap: var(--s3);
    padding: var(--s5);
  }
  .empty[hidden] {
    display: none;
  }
  .archived summary {
    display: flex;
    align-items: baseline;
    gap: var(--s3);
    cursor: pointer;
    font-weight: 600;
    font-size: var(--fs-lg);
  }
  .archived > p {
    margin: var(--s2) 0 var(--s3);
    font-size: var(--fs-sm);
  }
  .archived ul {
    display: grid;
    gap: var(--s3);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .archived li {
    display: grid;
    gap: 2px;
    padding: var(--s3) var(--s4);
    border: 1px solid var(--rule);
    border-radius: var(--radius);
    font-size: var(--fs-sm);
  }
  .archived li a {
    font-weight: 600;
  }
</style>
